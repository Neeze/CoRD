{
  "architectures": ["CordForCausalLM"],
  "model_type": "cord",
  "vocab_size": 32768,
  "hidden_size": 512,
  "intermediate_size": 2048,
  "num_hidden_layers": 2,
  "num_decoder_layers": 2,
  "num_attention_heads": 8,
  "num_key_value_heads": 4,
  "concept_slots": 64,
  "concept_num_attention_heads": 8,
  "concept_latent_size": 256,
  "num_recurrent_loops": 2,
  "max_recurrent_loops": 8,
  "num_kda_layers": 3,
  "num_mla_layers": 1,
  "kda_backend": "auto",
  "kda_chunk_size": 64,
  "latent_kv_size": 256,
  "routed_latent_width": 256,
  "expert_intermediate_size": 1024,
  "num_experts": 8,
  "num_experts_per_token": 2,
  "num_shared_experts": 1,
  "use_moe": true,
  "use_situ_glu": true,
  "num_reasoning_operators": 5,
  "hot_frontier_size": 8,
  "hot_frontier_max_size": 16,
  "gpu_checkpoint_slots": 4,
  "archive_checkpoint_interval": 4,
  "local_bptt_loops": 4,
  "max_position_embeddings": 2048,
  "use_cache": true,
  "tie_word_embeddings": true,
  "pad_token_id": 0,
  "bos_token_id": 1,
  "eos_token_id": 2
